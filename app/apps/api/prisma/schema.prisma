generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  /// set on account delete: row kept (anonymised) so consents + audit_log stay as legal proof
  deletedAt    DateTime?
  loginEvents  LoginEvent[]
  sessions     Session[]
  pii          Pii?
  consents     Consent[]
  accounts     Account[]
  uploads      Upload[]
  transactions Transaction[]
  rules        CategoryRule[]
  slips        Slip[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  device     String?
  location   String?

  @@map("sessions")
}

/// AES-256-GCM ciphertext (PII_KEY), base64 iv|tag|data
model Pii {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDateEnc  String?
  /// optional: without it only statements can be exported (no prefilled tax pack)
  nationalIdEnc String?
  /// Thai full legal name (tax forms)
  fullNameEnc   String?
  /// normalised Thai mobile 0XXXXXXXXX
  phoneEnc      String?
  /// satang per month, user-declared (not secret enough to encrypt)
  monthlySalary Int?
  updatedAt     DateTime @updatedAt

  @@map("pii")
}

/// append-only; latest row per purpose wins
model Consent {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  granted Boolean
  version String
  at      DateTime @default(now())

  @@index([userId, purpose, at])
  @@map("consents")
}

model Account {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank            String
  accountNoMasked String
  accountName     String?
  createdAt       DateTime      @default(now())
  transactions    Transaction[]

  @@unique([userId, bank, accountNoMasked])
  @@map("accounts")
}

model Upload {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank            String
  accountNoMasked String
  periodStart     String
  periodEnd       String
  sha256          String
  filePath        String
  status          String    @default("pending")
  parsed          Json
  rowCount        Int
  createdAt       DateTime  @default(now())
  confirmedAt     DateTime?
  /// original file name as sent by the browser (display only)
  fileName        String?
  ocr             Boolean   @default(false)
  transactions    Transaction[]

  @@index([userId, sha256])
  @@map("uploads")
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  uploadId    String?
  upload      Upload?  @relation(fields: [uploadId], references: [id])
  date        String
  time        String?
  description String
  channel     String?
  amount      Int
  direction   String
  balance     Int?
  category    String
  note        String?
  source      String
  verified    Boolean
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  edits       Edit[]

  @@index([userId, date])
  @@index([accountId, date])
  @@map("transactions")
}

/// append-only
model Edit {
  id            String      @id @default(uuid())
  userId        String
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  field         String
  oldValue      String?
  newValue      String?
  at            DateTime    @default(now())

  @@index([transactionId])
  @@map("edits")
}

model CategoryRule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern   String
  category  String
  updatedAt DateTime @updatedAt

  @@unique([userId, pattern])
  @@map("category_rules")
}

/// append-only hash chain; UPDATE/DELETE blocked by trigger in migration
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  actor     String
  action    String
  target    String?
  before    Json?
  after     Json?
  ipHmac    String?
  userAgent String?
  at        DateTime
  prevHash  String
  hash      String

  @@index([userId, at])
  @@map("audit_log")
}

/// Transfer slip read by OCR. The image itself is never stored (privacy): only its hash + extracted fields.
model Slip {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sha256               String
  qrRef                String?
  ref                  String?
  bank                 String?
  date                 String?
  time                 String?
  amount               Int?
  toName               String?
  confidence           Float
  status               String
  matchedTransactionId String?
  createdAt            DateTime @default(now())

  @@unique([userId, sha256])
  @@index([userId, qrRef])
  @@map("slips")
}

/// Login history shown to the user. Retention: 90 days (pruned on each login of that user).
model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  success   Boolean
  /// AES-256-GCM (PII_KEY) so the user can see their own IP; ipHmac for abuse matching
  ipEnc     String?
  ipHmac    String?
  userAgent String?
  device    String?
  location  String?
  sessionId String?

  @@index([userId, at])
  @@map("login_events")
}
