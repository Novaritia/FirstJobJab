generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  sessions     Session[]
  pii          Pii?
  consents     Consent[]
  accounts     Account[]
  uploads      Upload[]
  transactions Transaction[]
  rules        CategoryRule[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("sessions")
}

/// AES-256-GCM ciphertext (PII_KEY), base64 iv|tag|data
model Pii {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDateEnc  String
  nationalIdEnc String
  updatedAt     DateTime @updatedAt

  @@map("pii")
}

/// append-only; latest row per purpose wins
model Consent {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  granted Boolean
  version String
  at      DateTime @default(now())

  @@index([userId, purpose, at])
  @@map("consents")
}

model Account {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank            String
  accountNoMasked String
  accountName     String?
  createdAt       DateTime      @default(now())
  transactions    Transaction[]

  @@unique([userId, bank, accountNoMasked])
  @@map("accounts")
}

model Upload {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank            String
  accountNoMasked String
  periodStart     String
  periodEnd       String
  sha256          String
  filePath        String
  status          String    @default("pending")
  parsed          Json
  rowCount        Int
  createdAt       DateTime  @default(now())
  confirmedAt     DateTime?
  transactions    Transaction[]

  @@index([userId, sha256])
  @@map("uploads")
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  uploadId    String?
  upload      Upload?  @relation(fields: [uploadId], references: [id])
  date        String
  time        String?
  description String
  channel     String?
  amount      Int
  direction   String
  balance     Int?
  category    String
  note        String?
  source      String
  verified    Boolean
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  edits       Edit[]

  @@index([userId, date])
  @@index([accountId, date])
  @@map("transactions")
}

/// append-only
model Edit {
  id            String      @id @default(uuid())
  userId        String
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  field         String
  oldValue      String?
  newValue      String?
  at            DateTime    @default(now())

  @@index([transactionId])
  @@map("edits")
}

model CategoryRule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern   String
  category  String
  updatedAt DateTime @updatedAt

  @@unique([userId, pattern])
  @@map("category_rules")
}

/// append-only hash chain; UPDATE/DELETE blocked by trigger in migration
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  actor     String
  action    String
  target    String?
  before    Json?
  after     Json?
  ipHmac    String?
  userAgent String?
  at        DateTime
  prevHash  String
  hash      String

  @@index([userId, at])
  @@map("audit_log")
}
