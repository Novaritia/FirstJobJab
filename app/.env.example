DATABASE_URL=postgresql://fjm:fjm@localhost:5432/fjm
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# 32-byte base64 keys: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_KEY=
FILE_KEY=
IP_HMAC_KEY=
# Optional: free LLM to polish Thai summaries (Gemini first, else OpenAI, else template)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Local OCR sidecar (apps/ocr). Unset → tesseract only. Docker sets it to http://ocr:8765
OCR_URL=http://localhost:8765
# Optional: weekly voice summary (503 without it)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 has no Thai
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_STT_MODEL_ID=scribe_v2
# Proxy hops in front of the api: 0 = none (local), 1 = proxy manager only, 2 = Cloudflare + proxy manager
TRUST_PROXY=0

# --- Server deploy behind Cloudflare + Nginx Proxy Manager (docs/deploy.md) ---
# WEB_ORIGIN=https://app.example.com
# PUBLIC_API_URL=https://api.example.com   # docker build arg for web; rebuild web after changing
# TRUST_PROXY=2
# BIND_IP=127.0.0.1                        # api/web ports host-only; the proxy reaches them on the compose network
# NPM_NETWORK=npm_default                  # Docker network Nginx Proxy Manager is on
# POSTGRES_PASSWORD=change-me              # only takes effect on a fresh DB volume
